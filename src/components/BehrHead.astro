---
// <head> for the Jennifer Behr concept pages (outside the main site layout).
import "@/styles/behr.css";
interface Props { title: string }
const { title } = Astro.props;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex, nofollow" />
<title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<!-- Free stand-ins for the shop's fonts: Saol Display -> Cormorant Garamond,
     Plantin -> Crimson Pro, Founders Grotesk Text -> Hanken Grotesk -->
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400&family=Crimson+Pro:ital,wght@0,400;1,400&family=Hanken+Grotesk:wght@300;400;500&display=swap" rel="stylesheet" />

---
// RSVP for the first showing of the Behr (class project prototype).
// Static site with no backend: the form doesn't send or store anything yet.
import BehrHead from "@/components/BehrHead.astro";
import BehrHeader from "@/components/BehrHeader.astro";
import BehrFooter from "@/components/BehrFooter.astro";
import { url } from "@/consts";
---
<!doctype html>
<html lang="en">
  <head><BehrHead title="First Showing – Jennifer Behr (concept)" /></head>
  <body class="jb-body">
    <BehrHeader />
    <main class="jb-rsvp">
      <section class="jb-rsvp-card">
        <p class="jb-logo jb-logo--card">Jennifer&nbsp;&nbsp;Behr</p>
        <h1 class="jb-display jb-display--center">The First<br />Showing</h1>
        <p class="jb-body jb-center">
          The Behr makes its debut at a New York design museum, among pieces chosen for their craft. Afterwards, guests are invited to our
          Brooklyn studio to see the wax models, the tools and the hands that made it. Places are limited to fifty, one for each piece in the
          edition.
        </p>
        <form id="rsvp" class="jb-form" novalidate>
          <label><span class="jb-sr">Full name</span><input name="name" autocomplete="name" placeholder="FULL NAME" required /></label>
          <label><span class="jb-sr">Email address</span><input name="email" type="email" autocomplete="email" placeholder="EMAIL ADDRESS" required /></label>
          <label>
            <span class="jb-q">Are you…</span>
            <select name="role" required>
              <option value="" disabled selected>Select one…</option>
              <option>A Jennifer Behr client</option>
              <option>A bride-to-be</option>
              <option>A stylist</option>
              <option>An editor or journalist</option>
              <option>A buyer</option>
              <option>A collector</option>
              <option>New to the atelier</option>
            </select>
          </label>
          <fieldset>
            <legend class="jb-q">Which showing?</legend>
            <label class="jb-radio"><input type="radio" name="showing" value="both" checked /> Both</label>
            <label class="jb-radio"><input type="radio" name="showing" value="museum" /> The museum debut</label>
            <label class="jb-radio"><input type="radio" name="showing" value="studio" /> The studio visit</label>
          </fieldset>
          <fieldset>
            <legend class="jb-q">Guests</legend>
            <label class="jb-radio"><input type="radio" name="guests" value="1" checked /> Just me</label>
            <label class="jb-radio"><input type="radio" name="guests" value="2" /> Me and one guest</label>
          </fieldset>
          <p id="rsvp-err" class="jb-err" role="alert"></p>
          <button class="jb-btn jb-btn--block" type="submit">Request an invitation</button>
          <p class="jb-fine jb-center">Prototype form: nothing you enter is sent or stored.</p>
        </form>
        <div id="rsvp-done" class="jb-done" hidden>
          <h2 class="jb-display jb-display--center">You're on the List</h2>
          <p class="jb-body jb-center">Invitations are written by hand and sent from the studio. We'll be in touch with the dates and the venue.</p>
          <p class="jb-center"><a class="jb-link" href={url("/private/jennifer-behr-site/")}>Back to the Behr</a></p>
        </div>
      </section>
    </main>
    <BehrFooter />
    <script>
      // Prototype: validate and confirm on the page. Nothing is sent anywhere.
      const form = document.getElementById("rsvp") as HTMLFormElement;
      const err = document.getElementById("rsvp-err")!;
      form.addEventListener("input", () => (err.textContent = ""));
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const bad = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[required]")].find((f) => !f.checkValidity());
        if (bad) {
          err.textContent = bad.name === "email" ? "Please enter a valid email." : "Please fill in every field.";
          bad.focus();
          return;
        }
        form.hidden = true;
        document.getElementById("rsvp-done")!.hidden = false;
      });
    </script>
  </body>
</html>

---
import Layout from "@/layouts/Layout.astro";
import { PHOTOS, type Photo } from "@/data/gallery";
import { url } from "@/consts";

// Split the photos into columns of similar total height. Photos keep their own
// aspect ratio; every column is the same width, so the gutters stay straight.
function toColumns(photos: Photo[], n: number): Photo[][] {
  const cols: Photo[][] = Array.from({ length: n }, () => []);
  const heights = new Array(n).fill(0);
  for (const p of photos) {
    const i = heights.indexOf(Math.min(...heights));
    cols[i].push(p);
    heights[i] += p.height / p.width;
  }
  return cols;
}
const layouts = [
  { n: 3, cls: "hidden md:flex" },
  { n: 2, cls: "flex md:hidden" },
].map((l) => ({ ...l, cols: toColumns(PHOTOS, l.n) }));
---

<Layout title="Lookbook" description="Lookbook: editorial photos from the MAD Fashion show in Madrid, Pull&Bear, and the NYU FBA fashion show.">
  <section class="w-full flex flex-col md:flex-row gap-6 md:gap-0 px-4 md:pr-6 md:pl-28 pt-24 md:pt-0">
    <!-- Title: vertical on the right (Big City style), horizontal on phones -->
    <div class="md:order-2 text-[clamp(1.9rem,9vw,3rem)] md:text-[clamp(4rem,9vh,8rem)] md:w-24 md:ml-6 md:mr-2 relative shrink-0">
      <h1 class="md:sticky md:top-24 md:mt-24 md:rotate-90 md:origin-top-left md:translate-x-full md:whitespace-nowrap font-display">Lookbook</h1>
    </div>

    <!-- Auto-scrolling columns: each loops endlessly, neighbours move in opposite directions -->
    {layouts.map((layout) => (
      <div class={`lb-viewport ${layout.cls} flex-none md:flex-1 min-w-0 gap-3 md:gap-4`} aria-label="Lookbook photos">
        {layout.cols.map((col, ci) => (
          <div class="lb-col flex-1 min-w-0">
            <div class={`lb-track ${ci % 2 ? "lb-down" : "lb-up"}`}>
              {[0, 1].map((copy) =>
                col.map((p, i) => (
                  <img
                    src={url(p.src)}
                    alt={copy ? "" : p.alt}
                    aria-hidden={copy ? "true" : undefined}
                    width={p.width}
                    height={p.height}
                    loading={copy === 0 && i < 3 ? "eager" : "lazy"}
                    decoding="async"
                    class="lb-img"
                  />
                )),
              )}
            </div>
          </div>
        ))}
      </div>
    ))}
  </section>

  <style>
    .lb-viewport {
      height: calc(100vh - 7rem);
      overflow: hidden;
    }
    @media (min-width: 768px) {
      .lb-viewport { height: 100vh; }
    }
    .lb-col { overflow: hidden; height: 100%; touch-action: pan-x; }
    .lb-track {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      will-change: transform;
    }
    @media (min-width: 768px) {
      .lb-track { gap: 1rem; }
    }
    .lb-img {
      display: block;
      width: 100%;
      height: auto;
      background: #171717;
    }
    /* Reduced motion: a normal, scrollable grid with no animation and no repeated photos */
    @media (prefers-reduced-motion: reduce) {
      .lb-viewport { height: auto; overflow: visible; }
      .lb-col { height: auto; touch-action: auto; }
      .lb-track { transform: none !important; }
      .lb-track img[aria-hidden="true"] { display: none; }
    }
  </style>

  <script>
    // Each column loops endlessly; neighbours move in opposite directions.
    // Each column is independent: hovering one stops only that column, and the
    // mouse wheel then moves it up or down (no scrollbar, the page doesn't scroll)
    // while the other columns keep their own auto scroll.
    const SPEED = 30; // pixels per second
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // On touch screens a finger drag up or down moves just that column, a flick keeps
    // it gliding, and its auto scroll comes back a moment after the finger lifts.
    type Track = {
      el: HTMLElement;
      dir: number;
      offset: number;
      paused: boolean;
      pending: number;
      drag: number; // finger movement waiting for the next frame
      touching: boolean;
      axis: "" | "x" | "y";
      tx: number;
      ty: number;
      tt: number;
      v: number; // glide speed after a flick, px per ms
      resumeAt: number;
    };
    const tracks: Track[] = [...document.querySelectorAll<HTMLElement>(".lb-track")].map((el) => ({
      el,
      dir: el.classList.contains("lb-down") ? 1 : -1,
      offset: 0,
      paused: false,
      pending: 0,
      drag: 0,
      touching: false,
      axis: "",
      tx: 0,
      ty: 0,
      tt: 0,
      v: 0,
      resumeAt: 0,
    }));

    // The track holds the column twice; one copy plus one gap is the loop length.
    const period = (el: HTMLElement) =>
      (el.scrollHeight + (parseFloat(getComputedStyle(el).rowGap) || 0)) / 2;
    const wrap = (v: number, p: number) => {
      if (p <= 0) return 0;
      v %= p;
      return v > 0 ? v - p : v;
    };

    for (const t of tracks) {
      const col = t.el.parentElement as HTMLElement;
      col.addEventListener("pointerenter", (e) => {
        if (e.pointerType === "mouse") t.paused = true;
      });
      col.addEventListener("pointerleave", (e) => {
        if (e.pointerType !== "mouse") return;
        t.paused = false;
        t.pending = 0;
      });
      if (reduced) continue;
      col.addEventListener(
        "wheel",
        (e) => {
          const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? col.clientHeight : 1;
          const d = e.deltaY * unit;
          if (!d) return;
          e.preventDefault();
          t.pending += d;
        },
        { passive: false },
      );
      col.addEventListener(
        "touchstart",
        (e) => {
          const p = e.touches[0];
          Object.assign(t, { touching: true, axis: "", tx: p.clientX, ty: p.clientY, tt: e.timeStamp, v: 0 });
        },
        { passive: true },
      );
      col.addEventListener(
        "touchmove",
        (e) => {
          if (!t.touching) return;
          const p = e.touches[0];
          const dx = p.clientX - t.tx, dy = p.clientY - t.ty;
          if (!t.axis) {
            if (Math.abs(dx) < 4 && Math.abs(dy) < 4) return;
            t.axis = Math.abs(dy) >= Math.abs(dx) ? "y" : "x";
          }
          if (t.axis !== "y") { t.touching = false; return; }
          e.preventDefault();
          const dt = Math.max(1, e.timeStamp - t.tt);
          t.v = 0.8 * (dy / dt) + 0.2 * t.v;
          t.drag += dy;
          Object.assign(t, { tx: p.clientX, ty: p.clientY, tt: e.timeStamp });
        },
        { passive: false },
      );
      const end = (e: TouchEvent) => {
        if (t.axis === "y") t.resumeAt = performance.now() + 1500;
        // Glide only after a flick, not when the finger stopped before lifting.
        if (t.axis !== "y" || e.timeStamp - t.tt > 80) t.v = 0;
        t.touching = false;
        t.axis = "";
      };
      col.addEventListener("touchend", end);
      col.addEventListener("touchcancel", end);
    }

    if (!reduced) {
      let last = performance.now();
      const frame = (now: number) => {
        const dt = Math.min(0.1, (now - last) / 1000);
        last = now;
        for (const t of tracks) {
          if (t.el.offsetParent === null) continue; // hidden layout (phone vs desktop)
          let wheel = 0;
          if (t.pending) {
            wheel = Math.abs(t.pending) < 0.5 ? t.pending : t.pending * 0.25;
            t.pending -= wheel;
          }
          const p = period(t.el);
          let move = -wheel;
          if (t.drag) {
            move += t.drag;
            t.drag = 0;
          } else if (!t.touching && Math.abs(t.v) > 0.01) {
            move += t.v * dt * 1000; // flick glide
            t.v *= Math.pow(0.95, dt * 60);
          }
          const holding = (t.touching && t.axis === "y") || (!t.touching && now < t.resumeAt);
          if (!t.paused && !holding) move += t.dir * SPEED * dt;
          t.offset = wrap(t.offset + move, p);
          t.el.style.transform = `translate3d(0, ${t.offset}px, 0)`;
        }
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }
  </script>
</Layout>

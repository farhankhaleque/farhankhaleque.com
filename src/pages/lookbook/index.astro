---
import Layout from "@/layouts/Layout.astro";
import { PHOTOS, type Photo } from "@/data/gallery";
import { url } from "@/consts";

// Split the photos into columns of similar total height. Photos keep their own
// aspect ratio; every column is the same width, so the gutters stay straight.
function toColumns(photos: Photo[], n: number): Photo[][] {
  const cols: Photo[][] = Array.from({ length: n }, () => []);
  const heights = new Array(n).fill(0);
  for (const p of photos) {
    const i = heights.indexOf(Math.min(...heights));
    cols[i].push(p);
    heights[i] += p.height / p.width;
  }
  return cols;
}
const layouts = [
  { n: 3, cls: "hidden md:flex" },
  { n: 2, cls: "flex md:hidden" },
].map((l) => ({ ...l, cols: toColumns(PHOTOS, l.n) }));
---

<Layout title="Lookbook" description="Lookbook: editorial photos from the MAD Fashion show in Madrid, Pull&Bear, and the NYU FBA fashion show.">
  <section class="w-full flex flex-col md:flex-row gap-6 md:gap-0 px-4 md:pr-6 md:pl-28 pt-24 md:pt-0">
    <!-- Title: vertical on the right (Big City style), horizontal on phones -->
    <div class="md:order-2 text-[clamp(1.9rem,9vw,3rem)] md:text-[clamp(4rem,9vh,8rem)] md:w-24 md:ml-6 md:mr-2 relative shrink-0">
      <h1 class="md:sticky md:top-24 md:mt-24 md:rotate-90 md:origin-top-left md:translate-x-full md:whitespace-nowrap font-display">Lookbook</h1>
    </div>

    <!-- Auto-scrolling columns: each loops endlessly, neighbours move in opposite directions -->
    {layouts.map((layout) => (
      <div class={`lb-viewport ${layout.cls} flex-1 min-w-0 gap-3 md:gap-4`} aria-label="Lookbook photos">
        {layout.cols.map((col, ci) => (
          <div class="lb-col flex-1 min-w-0">
            <div class={`lb-track ${ci % 2 ? "lb-down" : "lb-up"}`}>
              {[0, 1].map((copy) =>
                col.map((p, i) => (
                  <img
                    src={url(p.src)}
                    alt={copy ? "" : p.alt}
                    aria-hidden={copy ? "true" : undefined}
                    width={p.width}
                    height={p.height}
                    loading={copy === 0 && i < 3 ? "eager" : "lazy"}
                    decoding="async"
                    class="lb-img"
                  />
                )),
              )}
            </div>
          </div>
        ))}
      </div>
    ))}
  </section>

  <style>
    .lb-viewport {
      height: calc(100vh - 7rem);
      overflow: hidden;
    }
    @media (min-width: 768px) {
      .lb-viewport { height: 100vh; }
    }
    .lb-col { overflow: hidden; height: 100%; }
    .lb-track {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      will-change: transform;
      animation: lb-up var(--lb-duration, 120s) linear infinite;
    }
    @media (min-width: 768px) {
      .lb-track { gap: 1rem; }
    }
    .lb-track.lb-down { animation-name: lb-down; }
    .lb-viewport:hover .lb-track { animation-play-state: paused; }
    .lb-img {
      display: block;
      width: 100%;
      height: auto;
      background: #171717;
    }
    /* The track holds the column twice; moving it by half its height (plus half a gap)
       lands exactly on the start of the second copy, so the loop is seamless. */
    @keyframes lb-up {
      from { transform: translateY(0); }
      to { transform: translateY(calc(-50% - var(--lb-gap-half, 0.375rem))); }
    }
    @keyframes lb-down {
      from { transform: translateY(calc(-50% - var(--lb-gap-half, 0.375rem))); }
      to { transform: translateY(0); }
    }
    @media (min-width: 768px) {
      .lb-track { --lb-gap-half: 0.5rem; }
    }
    /* Reduced motion: a normal, scrollable grid with no animation and no repeated photos */
    @media (prefers-reduced-motion: reduce) {
      .lb-viewport { height: auto; overflow: visible; }
      .lb-col { height: auto; }
      .lb-track { animation: none; }
      .lb-track img[aria-hidden="true"] { display: none; }
    }
  </style>

  <script>
    // Same scroll speed for every column: duration = distance / speed.
    const SPEED = 30; // pixels per second
    function setDurations() {
      document.querySelectorAll<HTMLElement>(".lb-track").forEach((t) => {
        const distance = t.scrollHeight / 2;
        if (distance > 0) t.style.setProperty("--lb-duration", `${distance / SPEED}s`);
      });
    }
    setDurations();
    window.addEventListener("load", setDurations);
    window.addEventListener("resize", setDurations);
  </script>
</Layout>

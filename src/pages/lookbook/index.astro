---
import Layout from "@/layouts/Layout.astro";
import { PHOTOS } from "@/data/gallery";
import { url } from "@/consts";

---

<Layout title="Lookbook" description="Lookbook: editorial photos from the MAD Fashion show in Madrid, Pull&Bear, and the NYU FBA fashion show.">
  <section class="w-full flex flex-col-reverse md:flex-row gap-6 md:gap-0 px-4 md:px-6 pt-24 pb-24">
    <ul class="flex-1 min-w-0 columns-2 md:columns-3 gap-3 md:gap-4">
      {PHOTOS.map((p, i) => (
        <li class="break-inside-avoid mb-3 md:mb-4">
          <img
            src={url(p.src)}
            alt={p.alt}
            width={p.width}
            height={p.height}
            loading={i < 6 ? "eager" : "lazy"}
            decoding="async"
            class="w-full h-auto block bg-neutral-900"
          />
        </li>
      ))}
    </ul>
    <!-- Vertical title on the right (Big City style); horizontal on phones -->
    <div class="text-[clamp(1.9rem,9vw,3rem)] md:text-[clamp(4rem,9vh,8rem)] md:w-24 md:ml-6 md:mr-2 relative shrink-0">
      <h1 class="md:sticky md:top-24 md:rotate-90 md:origin-top-left md:translate-x-full md:whitespace-nowrap font-display">Lookbook</h1>
    </div>
  </section>
</Layout>

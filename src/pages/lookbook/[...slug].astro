---
import { url } from "@/consts";
import { render } from "astro:content";
import { getLookbook } from "@/lib/experience";
import Entry from "@/layouts/Entry.astro";

export async function getStaticPaths() {
  const entries = await getLookbook();
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: entries[(i + 1) % entries.length] },
  }));
}
const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Entry
  title={d.title}
  subtitle={d.description}
  meta={[d.kicker]}
  color={d.color}
  image={d.image && url(d.image)}
  tags={d.tags}
  description={`${d.title}: ${d.description}`}
  back={{ href: url("/lookbook/"), text: "Lookbook" }}
  next={{ href: url(`/lookbook/${next.id}/`), text: `Next: ${next.data.title}` }}
>
  <Content />
</Entry>

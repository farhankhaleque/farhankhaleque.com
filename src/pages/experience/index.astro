---
import Layout from "@/layouts/Layout.astro";
import { getExperience, getExperienceList } from "@/lib/experience";
import { CURRENT_ROLES } from "@/data/leadership";
import { url } from "@/consts";

const chrono = await getExperience(); // oldest first
const roles = await getExperienceList(); // slide order: pinned first, chronological, pinned last
// Timeline rows: roles with timelineRow go on top (1 = top), the rest by date.
const pinned = chrono
  .filter((r) => r.data.timelineRow)
  .sort((a, b) => (a.data.timelineRow ?? 0) - (b.data.timelineRow ?? 0));
const jobs = [...pinned, ...chrono.filter((r) => r.data.group === "experience" && !r.data.timelineRow)];
const pastLeadership = chrono.filter((r) => r.data.group === "leadership" && !r.data.timelineRow);

// Timeline scale: from January of the first year up to today (the PRESENT bar).
// Bars run from the middle of the start month to the middle of the end month,
// so back to back roles touch without overlapping.
const now = new Date();
const months = (ym: string) => {
  if (ym === "present") return now.getFullYear() * 12 + now.getMonth();
  const [y, m] = ym.split("-").map(Number);
  return y * 12 + (m - 1);
};
const firstYear = Number(chrono[0].data.start.slice(0, 4));
const origin = firstYear * 12;
const presentAt = now.getFullYear() * 12 + now.getMonth() + 0.5 - origin;
const span = presentAt + 0.5;
const at = (ym: string) =>
  ym === "present" ? 100 : ((months(ym) - origin + 0.5) / span) * 100;
const years = Array.from({ length: now.getFullYear() - firstYear + 1 }, (_, i) => firstYear + i);
const segments = (r: (typeof roles)[number]) =>
  (r.data.periods ?? [{ start: r.data.start, end: r.data.end }]).map((p) => ({
    left: at(p.start),
    width: Math.max(at(p.end) - at(p.start), 0.8),
  }));

// First three bullets of each role, for the overview.
const highlights = roles.map((r) =>
  (r.body ?? "")
    .split("\n")
    .filter((l) => l.startsWith("- "))
    .map((l) => l.slice(2).trim())
    .slice(0, 3),
);
const pad = (n: number) => String(n).padStart(2, "0");
// Slide order: pinned-first role (BGMEA), roles by date, pinned-last role
// (Aurangzeb), then the Present (leadership) slide at the end.
type Slide = { kind: "role"; r: (typeof roles)[number]; bullets: string[] } | { kind: "present" };
const slides: Slide[] = [
  ...roles.map((r, i) => ({ kind: "role" as const, r, bullets: highlights[i] })),
  { kind: "present" as const },
];
const total = slides.length;
const slideId = (s: Slide) => (s.kind === "present" ? "present" : s.r.id);
const slideName = (s: Slide) => (s.kind === "present" ? "Present" : s.r.data.company);
// Display text sized to its box: the longest word always fits the container width
// (the box sets container-type: inline-size, so 100cqw is its inner width).
const fit = (text: string, max: string) => {
  const longest = Math.max(...text.split(" ").map((w) => w.length));
  return `font-size:min(${max}, calc(100cqw / ${(longest * 0.95).toFixed(2)}))`;
};
const [featured, ...others] = [
  ...CURRENT_ROLES.filter((c) => c.featured),
  ...CURRENT_ROLES.filter((c) => !c.featured),
];
const groups = [
  { label: "Experience", items: jobs },
  { label: "Leadership", items: pastLeadership },
];
---

<Layout
  title="Experience"
  description="Farhan Khaleque's experience, from pattern making in Dhaka to buying at Bloomingdale's, plus leadership at NYU."
>
  <section class="w-full max-w-[1200px] self-center px-4 md:px-8 pt-24 md:pt-28 pb-10">
    <h1 class="text-[clamp(1.9rem,8.2vw,6rem)] font-display">Experience</h1>
    <p class="text-lg md:text-xl max-w-2xl mt-6">
      From cutting production patterns in Dhaka to buying for Bloomingdale's, plus my own label.
    </p>
    <p class="font-nav text-xs opacity-60 mt-3 hidden md:block">
      Use the arrow keys to step through each role.
    </p>

    <!-- Timeline -->
    <div class="mt-14 grid md:grid-cols-[minmax(0,1fr)_3.5rem_minmax(0,17rem)] items-stretch">
      <!-- Past: bars by month -->
      <div class="relative min-w-0">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
          {years.map((y) => (
            <span class="absolute top-0 bottom-6 border-l border-white/15" style={`left:${((y * 12 - origin) / span) * 100}%`}></span>
          ))}
        </div>
        {groups.map((g) => (
          <div class="relative mb-5">
            <p class="font-nav text-xs tracking-widest border-b border-white pb-1 mb-3 bg-background relative z-10 inline-block pr-3">{g.label}</p>
            <ol class="flex flex-col gap-2">
              {g.items.map((r) => {
                const segs = segments(r);
                const first = segs[0];
                const last = segs[segs.length - 1];
                const end = last.left + last.width;
                const labelRight = end > 62;
                return (
                  <li class="relative h-9">
                    {segs.map((s) => (
                      <a
                        href={`#${r.id}`}
                        class={`tl-bar absolute top-0 h-9 ${r.data.end === "present" ? "bg-white" : "bg-neutral-500"}`}
                        style={`left:${s.left}%;width:${s.width}%`}
                        aria-label={`${r.data.company}, ${r.data.dates}`}
                      ></a>
                    ))}
                    <a
                      href={`#${r.id}`}
                      class="absolute top-0 h-9 flex items-center font-nav text-[11px] md:text-xs whitespace-nowrap hover:underline"
                      style={labelRight ? `right:${100 - first.left}%;padding-right:.5rem` : `left:${end}%;padding-left:.5rem`}
                      tabindex="-1"
                      aria-hidden="true"
                    >{r.data.company}</a>
                  </li>
                );
              })}
            </ol>
          </div>
        ))}
        <div class="relative h-6 font-nav text-xs">
          {years.map((y) => (
            <span class="absolute" style={`left:${((y * 12 - origin) / span) * 100}%`}>{y}</span>
          ))}
        </div>
      </div>

      <!-- PRESENT bar: vertical on desktop, horizontal on phones -->
      <div class="hidden md:flex justify-center items-stretch gap-2 pb-6" aria-hidden="true">
        <span class="w-2 bg-white"></span>
        <span class="present-label font-display text-sm">Present</span>
      </div>
      <div class="md:hidden flex items-center gap-3 my-8" aria-hidden="true">
        <span class="font-display text-sm">Present</span>
        <span class="h-2 bg-white flex-1"></span>
      </div>

      <!-- Current roles -->
      <div class="md:pl-2">
        <p class="font-nav text-xs tracking-widest border-b border-white pb-1 mb-4 inline-block pr-3">Leadership</p>
        <a href="#present" class="block group">
          <p class="font-bold text-lg leading-tight group-hover:underline">{featured.title}</p>
          <p class="text-sm">{featured.org}</p>
        </a>
        <ul class="mt-8 pl-5 border-l border-white/25 flex flex-col gap-4">
          {others.map((c) => (
            <li>
              <a href="#present" class="block group">
                <p class="font-bold leading-tight group-hover:underline">{c.title}</p>
                <p class="text-sm">{c.org}</p>
                {c.since && <p class="font-nav text-[11px] opacity-60 mt-0.5">Since {c.since}</p>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- One full-screen section per role, plus the Present slide -->
  <ol class="w-full">
    {slides.map((s, i) => {
      const next = slides[i + 1];
      const nextLink = next && (
        <a href={`#${slideId(next)}`} class="opacity-70 hover:opacity-100">Next: {slideName(next)} ↓</a>
      );
      if (s.kind === "present") {
        return (
          <li id="present" class="role-slide min-h-screen flex items-center border-t border-white/15 py-16 md:py-10">
            <div class="w-full max-w-[1100px] mx-auto px-4 md:px-8 grid md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] gap-8 md:gap-14 items-center">
              <div class="fit-box aspect-[4/3] md:aspect-[4/5] max-h-[78vh] w-full flex flex-col justify-between p-6 md:p-8 text-black bg-white">
                <p class="font-nav text-xs md:text-sm opacity-80">{pad(i + 1)} / {pad(total)} · Leadership</p>
                <div>
                  <p class="font-nav text-sm md:text-base opacity-90 mb-3">Now</p>
                  <h2 class="font-display" style={fit("Present", "3.75rem")}>Present</h2>
                </div>
              </div>
              <div>
                <p class="font-bold text-2xl md:text-3xl leading-tight">{featured.title}</p>
                <p class="text-lg">{featured.org}</p>
                <ul class="mt-10 pl-6 md:pl-8 border-l-2 border-white flex flex-col gap-8">
                  {others.map((c) => (
                    <li>
                      <p class="font-bold text-xl md:text-2xl leading-tight">{c.title}</p>
                      <p class="text-base md:text-lg">{c.org}</p>
                      {c.since && <p class="font-nav text-xs opacity-60 mt-1">Since {c.since}</p>}
                      {c.text && <p class="text-base md:text-lg mt-2 max-w-lg">{c.text}</p>}
                    </li>
                  ))}
                </ul>
                {nextLink && <div class="font-nav text-sm mt-10">{nextLink}</div>}
              </div>
            </div>
          </li>
        );
      }
      const r = s.r;
      return (
        <li id={r.id} class="role-slide min-h-screen flex items-center border-t border-white/15 py-16 md:py-10">
          <div class="w-full max-w-[1400px] mx-auto px-4 md:px-8 grid md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:grid-cols-[minmax(0,4fr)_minmax(0,5fr)_minmax(0,4fr)] gap-8 md:gap-10 lg:gap-12 items-center">
            <div
              class="fit-box aspect-[4/3] md:aspect-[4/5] lg:aspect-square w-full flex flex-col justify-between p-6 md:p-7 text-white border border-white/10"
              style={`background-color:${r.data.color}`}
            >
              <p class="font-nav text-xs md:text-sm opacity-80 flex flex-wrap justify-between gap-x-4 gap-y-1">
                <span>{pad(i + 1)} / {pad(total)}{r.data.group === "leadership" ? " · Leadership" : ""}</span>
                <span class="text-right">{r.data.location ?? ""}</span>
              </p>
              <div>
                <p class="font-nav text-sm md:text-base opacity-90 mb-3">{r.data.dates}</p>
                <h2 class="font-display" style={fit(r.data.company, "3.75rem")}>{r.data.company}</h2>
              </div>
            </div>
            <div class="fit-box flex flex-col gap-6 min-w-0">
              <div>
                <p class="font-display" style={fit(r.data.stat, "5rem")}>{r.data.stat}</p>
                <p class="text-lg md:text-xl mt-2 max-w-md">{r.data.statLabel}</p>
              </div>
              <p class="font-bold text-xl md:text-2xl leading-snug border-t border-white/20 pt-5">{r.data.role}</p>
              <ul class="entry text-base md:text-lg">
                {s.bullets.map((b) => <li>{b}</li>)}
              </ul>
              <div class="flex flex-wrap items-center gap-x-8 gap-y-3 font-nav text-sm">
                <a href={url(`/experience/${r.id}/`)} class="underline underline-offset-4">Full details</a>
                {nextLink}
              </div>
            </div>
            {r.data.image && (
              r.data.video ? (
                <button
                  type="button"
                  class="exp-media group md:col-start-2 lg:col-start-auto"
                  data-video={url(r.data.video)}
                  data-title={`${r.data.company} video`}
                  aria-label={`Play ${r.data.company} video`}
                >
                  <img src={url(r.data.image)} alt={`${r.data.company}`} width="1000" height="1000" loading="lazy" />
                  <span class="exp-badge"><span class="exp-play" aria-hidden="true"></span>Play video</span>
                </button>
              ) : r.data.link ? (
                <a href={r.data.link} target="_blank" rel="noopener" class="exp-media group md:col-start-2 lg:col-start-auto" aria-label={`${r.data.linkLabel ?? "Open"} (opens in a new tab)`}>
                  <img src={url(r.data.image)} alt={`${r.data.company}`} width="1000" height="1000" loading="lazy" />
                  <span class="exp-badge">{r.data.linkLabel ?? "Open"} ↗</span>
                </a>
              ) : (
                <div class="exp-media md:col-start-2 lg:col-start-auto">
                  <img src={url(r.data.image)} alt={`${r.data.company}`} width="1000" height="1000" loading="lazy" />
                </div>
              )
            )}
          </div>
        </li>
      );
    })}
  </ol>

  <!-- Video player popup -->
  <dialog id="video-dialog" class="video-dialog" aria-label="Video">
    <button type="button" class="video-close font-nav" aria-label="Close video">Close ✕</button>
    <video id="video-player" controls playsinline preload="metadata"></video>
  </dialog>

  <style>
    .tl-bar { min-width: 8px; transition: filter 0.2s; }
    .fit-box { container-type: inline-size; }
    .exp-media {
      position: relative; display: block; width: 100%; max-width: 100%; aspect-ratio: 1 / 1;
      overflow: hidden; background: #111; border: 1px solid rgb(255 255 255 / 0.1);
      padding: 0; cursor: default;
    }
    button.exp-media, a.exp-media { cursor: pointer; }
    .exp-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s ease; }
    button.exp-media:hover img, a.exp-media:hover img { transform: scale(1.03); }
    .exp-badge {
      position: absolute; left: 12px; bottom: 12px; display: inline-flex; align-items: center; gap: 8px;
      background: #fff; color: #000; font-family: var(--font-nav); text-transform: uppercase;
      font-size: 11px; letter-spacing: 0.04em; padding: 7px 12px;
    }
    .exp-play { width: 0; height: 0; border-left: 8px solid #000; border-top: 5px solid transparent; border-bottom: 5px solid transparent; }
    .exp-media:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
    .video-dialog {
      background: #000; border: 1px solid rgb(255 255 255 / 0.2); padding: 0; max-width: min(92vw, 1200px);
      max-height: 90vh; color: #fff; overflow: visible;
    }
    .video-dialog::backdrop { background: rgb(0 0 0 / 0.85); }
    .video-dialog video { display: block; max-width: min(92vw, 1200px); max-height: 85vh; width: auto; height: auto; }
    .video-close {
      position: absolute; top: -36px; right: 0; background: none; border: 0; color: #fff;
      text-transform: uppercase; font-size: 12px; letter-spacing: 0.05em; cursor: pointer;
    }
    .tl-bar:hover { filter: brightness(1.3); }
    .present-label {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      letter-spacing: 0.05em;
    }
  </style>

  <script>
    // Arrow keys / J and K step through roles like slides.
    function setup() {
      const slides = Array.from(document.querySelectorAll<HTMLElement>(".role-slide"));
      if (!slides.length) return;
      const current = () => {
        const mid = window.innerHeight / 3;
        let idx = -1;
        slides.forEach((s, i) => {
          if (s.getBoundingClientRect().top <= mid) idx = i;
        });
        return idx;
      };
      document.addEventListener("keydown", (e) => {
        if ((document.getElementById("video-dialog") as HTMLDialogElement | null)?.open) return;
        const t = e.target as HTMLElement;
        if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const down = ["ArrowDown", "ArrowRight", "j", "PageDown"].includes(e.key);
        const up = ["ArrowUp", "ArrowLeft", "k", "PageUp"].includes(e.key);
        if (!down && !up) return;
        e.preventDefault();
        const i = current();
        const next = down ? Math.min(i + 1, slides.length - 1) : i - 1;
        if (next < 0) window.scrollTo({ top: 0, behavior: "smooth" });
        else slides[next].scrollIntoView({ behavior: "smooth", block: "start" });
      });
    }
    setup();

    // Clicking a role picture with a video opens it in the popup player.
    const dialog = document.getElementById("video-dialog") as HTMLDialogElement;
    const player = document.getElementById("video-player") as HTMLVideoElement;
    document.querySelectorAll<HTMLButtonElement>("[data-video]").forEach((btn) =>
      btn.addEventListener("click", () => {
        player.src = btn.dataset.video ?? "";
        dialog.setAttribute("aria-label", btn.dataset.title ?? "Video");
        dialog.showModal();
        player.play().catch(() => {});
      }),
    );
    const closeVideo = () => dialog.close();
    dialog.querySelector(".video-close")?.addEventListener("click", closeVideo);
    dialog.addEventListener("click", (e) => { if (e.target === dialog) closeVideo(); });
    dialog.addEventListener("close", () => { player.pause(); player.removeAttribute("src"); player.load(); });
  </script>
</Layout>

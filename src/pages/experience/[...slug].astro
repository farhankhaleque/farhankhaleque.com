---
import { url } from "@/consts";
import { render } from "astro:content";
import { getExperienceList } from "@/lib/experience";
import Entry from "@/layouts/Entry.astro";

export async function getStaticPaths() {
  const entries = await getExperienceList();
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: entries[(i + 1) % entries.length] },
  }));
}
const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Entry
  title={d.company}
  subtitle={d.role}
  meta={[d.dates, d.location].filter((m): m is string => Boolean(m))}
  color={d.color}
  description={`${d.role} at ${d.company}. ${d.summary}.`}
  back={{ href: url(`/experience/#${entry.id}`), text: "All experience" }}
  next={{ href: url(`/experience/${next.id}/`), text: `Next: ${next.data.company}` }}
>
  <Content />
</Entry>

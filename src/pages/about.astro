---
import Layout from "../layouts/Layout.astro";
import { url } from "@/consts";

// Headshot: the file lives in public/headshots/.
const headshot = { src: "/headshots/headshot.jpg", alt: "Portrait of Farhan Khaleque" };

const facts = [
  { label: "Education", lines: ["New York University", "B.A. Computer Science & Middle Eastern Studies", "Expected May 2027"] },
  { label: "Awards", lines: ["YouTube Silver Play Button", "Gunter Georgi Award for Outstanding Engineering, NYU Tandon", "Dream Big Be Bold Award (x2), Bloomingdale's"] },
  { label: "Certifications", lines: ["Google Ads, Google Analytics, Google AI", "Microsoft Office Specialist Excel Expert", "Lean Six Sigma Yellow Belt", "Inside LVMH (2026)"] },
  { label: "Languages", lines: ["English, Bengali, Hindi, and Urdu (fluent)", "Arabic and Spanish (working proficiency)"] },
  { label: "Tools", lines: ["Shopify, Excel, SQL & BigQuery, Python", "PLM, NuOrder, Joor, SAP", "Klaviyo, Google Analytics, Photoshop, Premiere Pro"] },
];
---

<Layout
  title="About"
  description="Farhan “Aurangzeb” Khaleque is a New York based designer and supply chain specialist whose work bridges fashion, business, and technology."
>
  <section class="flex flex-col items-center py-10 pb-32 px-4">
    <!-- Headshot, on top -->
    <div class="w-full max-w-5xl pt-20">
      <img
        src={url(headshot.src)}
        alt={headshot.alt}
        width="880"
        height="1173"
        class="w-full sm:w-1/2 aspect-[3/4] object-cover"
        fetchpriority="high"
      />
    </div>

    <div class="w-full max-w-5xl mt-20">
      <h1 class="font-display text-[clamp(1.5rem,6.2vw,4.5rem)] md:whitespace-nowrap pb-10" data-fit><span class="inline-block">Sculptor // Sculpture</span></h1>
      <div class="text-lg md:text-xl flex flex-col gap-5 max-w-2xl">
        <p>
          Farhan “Aurangzeb” Khaleque is a New York based designer and supply chain specialist whose work
          bridges fashion, business, and technology. His eye for detail comes alive in both the cut of denim
          and the shape of patterns, treating garments not just as products but as narratives of craft and culture.
        </p>
        <p>Fashion is a language, and his work is about making the technical beautiful.</p>
      </div>
    </div>

    <div class="w-full max-w-5xl mt-24">
      <h2 class="font-display text-[clamp(1.5rem,6.2vw,4.5rem)] md:whitespace-nowrap pb-10" data-fit><span class="inline-block">Design Principles</span></h2>
      <div class="text-lg md:text-xl flex flex-col gap-5 max-w-2xl">
        <p>
          Aurangzeb brings a streetwear perspective to contemporary fashion, blending global trends with the
          pulse of New York youth culture. His work traces the evolution of denim, twill, and ready to wear
          through a lens of authenticity.
        </p>
        <p>
          Where design meets data, and luxury meets everyday wear. He offers creative direction and production
          insight for brands looking to connect with the next generation of style innovators.
        </p>
      </div>
    </div>

    <dl class="w-full max-w-5xl mt-28 grid md:grid-cols-2 gap-x-12 gap-y-8">
      {facts.map((f) => (
        <div class="border-t border-white/25 pt-4">
          <dt class="font-nav text-xs tracking-widest mb-2 opacity-70">{f.label}</dt>
          {f.lines.map((line) => <dd class="text-lg">{line}</dd>)}
        </div>
      ))}
    </dl>
  </section>

  <script>
    // Desktop only: size each [data-fit] heading so its text spans the full content width.
    const desktop = window.matchMedia("(min-width: 768px)");
    function fitHeadings() {
      document.querySelectorAll<HTMLElement>("[data-fit]").forEach((h) => {
        h.style.fontSize = "";
        if (!desktop.matches) return;
        const text = h.querySelector("span");
        if (!text) return;
        const current = parseFloat(getComputedStyle(h).fontSize);
        const width = text.getBoundingClientRect().width;
        if (width > 0) h.style.fontSize = `${(current * h.clientWidth) / width}px`;
      });
    }
    fitHeadings();
    document.fonts?.ready.then(fitHeadings);
    window.addEventListener("resize", fitHeadings);
  </script>
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import HomeMob from "@/components/HomeMob.astro";
import VerticalCarousel from "@/components/react/VerticalCarousel";
import { PANELS } from "@/data/home";
import SewingNeedle from "@/components/SewingNeedle.astro";
---

<Layout>
  <div class="md:flex-row flex flex-col md:gap-10 relative grow">
    <div class="relative hidden md:flex flex-1 min-h-screen">
      <h1 class="text-5xl lg:text-6xl xl:text-7xl absolute z-20 -right-6 lg:-right-10 bottom-1/3 font-display text-right">
        Farhan Khaleque
      </h1>
      <p class="text-xl absolute bottom-1/4 right-0 text-right max-w-80">designer</p>
      <SewingNeedle class="absolute top-24 left-4 w-56 text-white" />
    </div>
    <HomeMob />
    <div class="md:min-h-screen md:w-1/2 max-h-full overflow-hidden">
      <VerticalCarousel client:visible panels={PANELS} />
    </div>
  </div>
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import HomeMob from "@/components/HomeMob.astro";
import VerticalCarousel from "@/components/react/VerticalCarousel";
import { PANELS } from "@/data/home";
import SewingNeedle from "@/components/SewingNeedle.astro";
---

<Layout>
  <div class="md:flex-row flex flex-col md:gap-10 relative grow">
    <div class="relative hidden md:flex flex-1 min-h-screen">
      <!-- Name with tagline tucked right underneath -->
      <div class="absolute z-20 -right-6 lg:-right-10 bottom-1/4 flex flex-col items-end text-right">
        <h1 class="text-5xl lg:text-6xl xl:text-7xl font-display">Farhan Khaleque</h1>
        <div class="mr-6 lg:mr-10 mt-4">
          <p class="text-xl">designer</p>
          <p class="text-base mt-1 opacity-80">computer science &amp; middle eastern studies @ NYU</p>
        </div>
      </div>
      <SewingNeedle class="absolute bottom-10 left-4 w-32 text-white" />
    </div>
    <HomeMob />
    <div class="md:min-h-screen md:w-1/2 max-h-full overflow-hidden">
      <VerticalCarousel client:visible panels={PANELS} />
    </div>
  </div>
</Layout>

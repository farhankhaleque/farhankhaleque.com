---
import Layout from "@/layouts/Layout.astro";
import { url } from "@/consts";
import { FIXES, SOURCES, type Area } from "@/data/balenciaga-review";

const AREAS: Area[] = ["Product page", "Bag & delivery", "Browsing", "Search", "Sitewide"];
const defects = FIXES.filter((f) => f.kind === "QA defect").length;
const tests = FIXES.length - defects;
const stats = [
  { n: String(FIXES.length), label: "fixes" },
  { n: String(defects), label: "QA defects" },
  { n: String(tests), label: "test ideas" },
  { n: "62", label: "real products rebuilt" },
];
---

<Layout
  title="Balenciaga Site Review"
  description="An independent review of balenciaga.com on November 25, 2026: 24 fixes, rebuilt in a working prototype and backed by research."
>
  <article class="cs flex flex-col items-center pt-28 pb-32 px-4">
    <header class="w-full max-w-5xl">
      <p class="font-nav text-xs tracking-widest opacity-70 mb-4">Case study · November 2026</p>
      <h1 class="font-display text-[clamp(2.2rem,9vw,6.5rem)]">Balenciaga<br />site review</h1>
      <div class="text-lg md:text-xl flex flex-col gap-5 max-w-2xl mt-10">
        <p>
          On November 25, 2026 I went through balenciaga.com/en-us the way a customer would, from the homepage to the
          checkout email step, and logged everything that broke or slowed me down. Then I rebuilt the store as a
          working prototype with every fix in place, using 62 of their real products, so I could show each change
          instead of describing it.
        </p>
        <p class="text-base opacity-70">
          This is an independent review. I'm not affiliated with Balenciaga. The prototype stays offline because it uses
          their products and photos, so the screens below are my own wireframes.
        </p>
      </div>
      <dl class="grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-6 mt-16 border-t border-white/25 pt-6">
        {stats.map((s) => (
          <div>
            <dt class="font-display text-5xl md:text-6xl">{s.n}</dt>
            <dd class="font-nav text-xs tracking-widest opacity-70 mt-2">{s.label}</dd>
          </div>
        ))}
      </dl>
    </header>

    <section class="w-full max-w-5xl mt-28">
      <h2 class="font-display text-[clamp(1.6rem,5vw,3.5rem)] pb-8">How I sorted it</h2>
      <div class="text-lg md:text-xl flex flex-col gap-5 max-w-2xl">
        <p>
          Honestly, the fundamentals are good. Guest checkout comes first, shipping and returns are free, and product
          pages give a delivery estimate. What I kept running into was the site saying slightly different things in
          different places.
        </p>
        <p>
          So I split everything into two kinds. QA defects are plainly broken and safe to fix right away: a template
          string showing in the cart, two different cutoff times for the same service. Test ideas are changes I'd want
          to A/B test first, because most of the research behind them comes from mass retail, and Baymard's luxury
          benchmark doesn't include Balenciaga.
        </p>
      </div>
    </section>

    <section class="w-full max-w-5xl mt-28" aria-labelledby="screens">
      <h2 id="screens" class="font-display text-[clamp(1.6rem,5vw,3.5rem)] pb-4">Screen by screen</h2>
      <p class="text-lg max-w-2xl pb-12 opacity-80">The numbers match the full list further down.</p>

      <!-- Product page -->
      <figure class="wf-fig">
        <div class="wf grid md:grid-cols-[1fr_1fr] gap-4">
          <div class="grid grid-cols-2 gap-1 content-start">
            <div class="blk aspect-square"></div><div class="blk aspect-square"></div>
            <div class="blk aspect-square"></div><div class="blk aspect-square"></div>
          </div>
          <div class="flex flex-col gap-3">
            <div class="ln w-1/2 h-3"></div>
            <div class="ln w-1/4 h-3"></div>
            <div class="call"><span class="co">15</span><span class="txt">or 4 interest free payments of $272.50 with Klarna</span></div>
            <div class="call"><span class="co">11</span><div class="flex flex-wrap gap-1">{["39", "40", "41", "42", "43", "44", "45", "46"].map((s) => <span class="sz">{s}</span>)}</div></div>
            <div class="call"><span class="co">10</span><span class="txt">Runs large · Size & fit</span></div>
            <div class="btn">Add to bag</div>
            <div class="call box"><span class="co">14</span>
              <div class="flex flex-col gap-1 w-full">
                <span class="txt flex justify-between gap-2"><span>Next business day, order by 12pm ET <span class="co sm">2</span></span><span>Fri, Nov 27 <span class="co sm">24</span></span></span>
                <span class="txt flex justify-between gap-2"><span>Pick up in store <span class="co sm">3</span></span><span>2 to 4 days</span></span>
                <span class="txt opacity-70">Free shipping · Free 30 day returns</span>
              </div>
            </div>
            <div class="call"><span class="co">21</span><span class="txt">Chat · Call · Email</span></div>
            <div class="call"><span class="co">22</span><span class="txt">Material & craft: composition, made in, hardware</span></div>
          </div>
          <div class="call md:col-span-2"><span class="co">20</span>
            <div class="grid grid-cols-3 gap-2 w-full">
              {["Style it with", "Similar items", "Recently viewed"].map((t) => <div class="flex flex-col gap-1"><div class="blk h-10"></div><span class="txt">{t}</span></div>)}
            </div>
          </div>
        </div>
        <figcaption>Product page. Size, fit, payment and delivery terms all sit next to the button.</figcaption>
      </figure>

      <!-- Bag -->
      <figure class="wf-fig">
        <div class="wf flex flex-col gap-2 max-w-xl">
          <span class="lbl">Delivery</span>
          <div class="row"><span class="co">1</span><span class="txt flex-1">Standard<br /><span class="opacity-70">Estimated delivery: Mon, Nov 30 to Thu, Dec 3</span></span><span class="txt">Free</span></div>
          <div class="row"><span class="co">2</span><span class="txt flex-1">Next business day, order by 12pm ET<br /><span class="opacity-70">Estimated delivery: Fri, Nov 27</span></span><span class="co sm">24</span></div>
          <div class="row"><span class="co">3</span><span class="txt flex-1">Pick up in store<br /><span class="opacity-70">Estimated delivery: Mon, Nov 30 to Wed, Dec 2</span></span></div>
          <div class="flex justify-between txt pt-2 border-t border-white/25"><span>Estimated total</span><span>Shown up front</span></div>
        </div>
        <figcaption>Bag. Real dates where the template string was, one cutoff, one pickup window, no Thanksgiving delivery. Dates as of November 25.</figcaption>
      </figure>

      <!-- Listing -->
      <figure class="wf-fig">
        <div class="wf flex flex-col gap-3">
          <div class="flex flex-wrap gap-3 items-center">
            <div class="call"><span class="co">16</span><span class="pill">Sort: Suggested</span><span class="pill">Price: min to max</span></div>
            <div class="call"><span class="co">9</span><span class="pill">Size (EU)</span></div>
            <div class="call"><span class="co">8</span><span class="pill">Hardware: Black · Brass</span></div>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-1">
            {[0, 1, 2, 3].map((i) => (
              <div class="flex flex-col gap-1">
                <div class="blk aspect-square"></div>
                <div class="ln w-2/3 h-2"></div>
                {i === 1 ? (
                  <div class="flex items-center gap-1"><span class="co sm">17</span><span class="dot bg-white"></span><span class="dot bg-neutral-500"></span><span class="dot bg-neutral-700"></span><span class="txt">3 colors</span></div>
                ) : <div class="ln w-1/3 h-2"></div>}
              </div>
            ))}
          </div>
        </div>
        <figcaption>Category page. One tile per style, a price filter, and one size scale.</figcaption>
      </figure>

      <!-- Search -->
      <figure class="wf-fig">
        <div class="wf flex flex-col gap-3 max-w-xl">
          <div class="call"><span class="co">5</span><span class="tab">Search results for “returns” | Balenciaga US</span></div>
          <div class="call"><span class="co">19</span>
            <div class="w-full"><div class="pill w-full">hood</div><div class="txt pl-2 pt-1 opacity-80">Ripped Tape Medium Fit Hoodie<br />Bodies Half Zip Cutline Hoodie</div></div>
          </div>
          <div class="call box"><span class="co">18</span>
            <div class="txt flex flex-col gap-1">
              <span>No products match “returns”.</span>
              <span class="underline">Returns: free within 30 days</span>
              <span class="opacity-70">Browse sneakers · ready to wear · bags · chat with us</span>
            </div>
          </div>
        </div>
        <figcaption>Search. The query shows in the tab, suggestions match the word, and an empty search points somewhere useful.</figcaption>
      </figure>
    </section>

    <section class="w-full max-w-5xl mt-28" aria-labelledby="all">
      <h2 id="all" class="font-display text-[clamp(1.6rem,5vw,3.5rem)] pb-8">All {FIXES.length} fixes</h2>
      {AREAS.map((area) => (
        <div class="mb-14">
          <h3 class="font-nav text-xs tracking-widest opacity-70 border-t border-white/25 pt-4 mb-6">{area}</h3>
          <ol class="flex flex-col gap-8">
            {FIXES.filter((f) => f.area === area).map((f) => (
              <li class="grid md:grid-cols-[3rem_1fr] gap-2 md:gap-4">
                <span class="co lg" aria-hidden="true">{f.n}</span>
                <div>
                  <p class="text-lg md:text-xl font-bold">{f.title} <span class="font-nav text-[10px] tracking-widest opacity-60 font-normal align-middle ml-2">{f.kind}</span></p>
                  <dl class="grid md:grid-cols-[7rem_1fr] gap-x-4 gap-y-1 mt-2 text-base">
                    <dt class="font-nav text-xs tracking-widest opacity-60 pt-1">Live site</dt><dd>{f.live}</dd>
                    <dt class="font-nav text-xs tracking-widest opacity-60 pt-1">My change</dt><dd>{f.change}</dd>
                    <dt class="font-nav text-xs tracking-widest opacity-60 pt-1">Why</dt><dd class="opacity-80">{f.why}</dd>
                  </dl>
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </section>

    <section class="w-full max-w-5xl mt-16">
      <h2 class="font-display text-[clamp(1.6rem,5vw,3.5rem)] pb-8">What I left alone</h2>
      <div class="text-lg md:text-xl flex flex-col gap-5 max-w-2xl">
        <p>
          The site has no reviews, star ratings or low stock messages, and I didn't add any. The well known reviews
          numbers come from mass retail and a reviews vendor, and I couldn't find a single experiment testing ratings,
          countdown timers or "people are viewing" messages on a luxury brand's own site. BCG found 70% of luxury
          shoppers have walked away over a price that felt unjustified, which to me argues for better material and
          craft copy, not discount cues. The video first homepage is a brand decision, so I left that too.
        </p>
        <p class="text-base opacity-70">
          Limits: this is one desktop session on one day. I didn't go past the checkout email step or test on a real
          phone, and the site may have changed since, so every item would need a recheck before it's raised.
        </p>
      </div>
    </section>

    <section class="w-full max-w-5xl mt-20">
      <h2 class="font-nav text-xs tracking-widest opacity-70 border-t border-white/25 pt-4 mb-4">Sources</h2>
      <ul class="flex flex-col gap-2 text-base">
        {SOURCES.map((s) => <li><a href={s.url} target="_blank" rel="noopener" class="underline underline-offset-4 decoration-white/40 hover:decoration-white">{s.name}</a></li>)}
      </ul>
      <p class="mt-16"><a href={url("/case-studies")} class="font-nav text-sm tracking-widest underline underline-offset-4">All case studies</a></p>
    </section>
  </article>

  <style>
    .wf-fig { margin: 0 0 4rem; }
    .wf { border: 1px solid rgb(255 255 255 / 0.25); padding: 1.25rem; }
    @media (min-width: 768px) { .wf { padding: 2rem; } }
    figcaption { margin-top: 0.75rem; font-size: 1rem; opacity: 0.75; max-width: 42rem; }
    .blk { background: #1c1c1c; }
    .ln { background: #2e2e2e; }
    .txt { font-family: Inter, "Helvetica Neue", Arial, sans-serif; font-size: 0.8rem; line-height: 1.4; }
    .lbl { font-family: Inter, sans-serif; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.7rem; opacity: 0.7; }
    .call { display: flex; gap: 0.6rem; align-items: center; min-width: 0; }
    .call.box, .row { border: 1px dashed rgb(255 255 255 / 0.45); padding: 0.6rem; align-items: flex-start; }
    .row { display: flex; gap: 0.6rem; align-items: center; }
    .co { flex: none; display: inline-grid; place-items: center; width: 1.5rem; height: 1.5rem; border-radius: 9999px; background: #f4f4f4; color: #000; font-family: Inter, sans-serif; font-weight: 700; font-size: 0.7rem; }
    .co.sm { width: 1.15rem; height: 1.15rem; font-size: 0.6rem; vertical-align: middle; }
    .co.lg { width: 2.25rem; height: 2.25rem; font-size: 0.85rem; }
    .sz { border: 1px solid rgb(255 255 255 / 0.3); font-family: Inter, sans-serif; font-size: 0.7rem; padding: 0.3rem 0.45rem; }
    .btn { background: #f4f4f4; color: #000; text-align: center; padding: 0.7rem; font-family: Inter, sans-serif; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.75rem; }
    .pill { border: 1px solid rgb(255 255 255 / 0.3); font-family: Inter, sans-serif; font-size: 0.75rem; padding: 0.35rem 0.6rem; white-space: nowrap; }
    .tab { background: #1c1c1c; font-family: Inter, sans-serif; font-size: 0.75rem; padding: 0.45rem 0.8rem; border-radius: 0.4rem 0.4rem 0 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dot { width: 0.6rem; height: 0.6rem; border-radius: 9999px; display: inline-block; }
  </style>
</Layout>

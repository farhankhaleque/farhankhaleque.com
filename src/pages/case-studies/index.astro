---
import Layout from "@/layouts/Layout.astro";
import { url } from "@/consts";

const studies = [
  {
    href: "/case-studies/balenciaga",
    title: "Balenciaga site review",
    date: "November 2026",
    text: "I walked balenciaga.com as a customer, logged 24 fixes, and rebuilt the store as a working prototype to show each one.",
  },
];
---

<Layout title="Case Studies" description="Case studies by Farhan Khaleque: site reviews and rebuilds in fashion e-commerce.">
  <section class="flex flex-col items-center pt-28 pb-32 px-4">
    <div class="w-full max-w-5xl">
      <h1 class="font-display text-[clamp(2.2rem,9vw,6.5rem)] pb-12">Case studies</h1>
      <ul class="flex flex-col">
        {studies.map((s) => (
          <li class="border-t border-white/25">
            <a href={url(s.href)} class="group grid md:grid-cols-[1fr_2fr] gap-2 md:gap-8 py-8">
              <div>
                <p class="font-nav text-xs tracking-widest opacity-70">{s.date}</p>
                <p class="font-display text-3xl md:text-4xl mt-2 group-hover:underline underline-offset-8">{s.title}</p>
              </div>
              <p class="text-lg md:text-xl opacity-85">{s.text}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

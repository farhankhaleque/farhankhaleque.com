---
// Password-protected page. The content is AES-encrypted ahead of time by
// scripts/encrypt-private.mjs, so the built site only ships ciphertext:
// without the password there is nothing readable in the HTML or the repo.
import Layout from "@/layouts/Layout.astro";
import payload from "@/data/private.enc.json";
---

<Layout title="Private" description="A private page." noindex>
  <section id="private-gate" class="flex grow py-32 flex-col justify-center items-center px-4 text-center min-h-[80vh]">
    <h1 class="text-5xl md:text-8xl font-display pb-8">Private.</h1>
    <p class="text-xl max-w-lg mb-10">This page needs a password.</p>
    <form id="private-form" class="flex flex-col sm:flex-row gap-4 w-full max-w-md">
      <label for="private-password" class="sr-only">Password</label>
      <input
        id="private-password"
        type="password"
        autocomplete="current-password"
        required
        placeholder="Password"
        class="grow bg-transparent border border-dotted px-4 py-3 text-lg outline-none focus:border-solid"
      />
      <button type="submit" class="border px-6 py-3 text-lg cursor-pointer hover:bg-[#f4f4f4] hover:text-black transition-colors">
        Enter
      </button>
    </form>
    <p id="private-error" class="mt-6 min-h-[1.5em] text-lg" role="alert" aria-live="polite"></p>
  </section>
  <section id="private-content" class="hidden py-32 px-4 max-w-5xl w-full mx-auto"></section>
</Layout>

<script is:inline define:vars={{ payload }}>
  const KEY = "private-page-password";
  const form = document.getElementById("private-form");
  const input = document.getElementById("private-password");
  const error = document.getElementById("private-error");
  const gate = document.getElementById("private-gate");
  const out = document.getElementById("private-content");
  const unb64 = (s) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));

  async function unlock(password) {
    const enc = new TextEncoder();
    const base = await crypto.subtle.importKey("raw", enc.encode(password), "PBKDF2", false, ["deriveKey"]);
    const key = await crypto.subtle.deriveKey(
      { name: "PBKDF2", salt: unb64(payload.salt), iterations: payload.iterations, hash: "SHA-256" },
      base,
      { name: "AES-GCM", length: 256 },
      false,
      ["decrypt"],
    );
    const plain = await crypto.subtle.decrypt({ name: "AES-GCM", iv: unb64(payload.iv) }, key, unb64(payload.data));
    return new TextDecoder().decode(plain);
  }

  function show(html) {
    out.innerHTML = html;
    gate.classList.add("hidden");
    out.classList.remove("hidden");
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    error.textContent = "Checking…";
    try {
      const html = await unlock(input.value);
      try { sessionStorage.setItem(KEY, input.value); } catch {}
      error.textContent = "";
      show(html);
    } catch {
      error.textContent = "That password isn't right.";
      input.select();
    }
  });

  // Stay unlocked for the rest of this browser tab's session.
  let saved = null;
  try { saved = sessionStorage.getItem(KEY); } catch {}
  if (saved) unlock(saved).then(show).catch(() => { try { sessionStorage.removeItem(KEY); } catch {} });
</script>

---
import "@/styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Hamburger from "@/components/react/Hamburger";
import DeskMenu from "@/components/DeskMenu.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  footer?: boolean;
}
const { title, description = SITE_DESCRIPTION, footer = true } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={fullTitle} description={description} />
    <style is:inline>
      body { font-family: "Roboto Condensed", sans-serif; background-color: #f2f2f2; color: #040404; margin: 0; padding: 0; }
      .container { max-width: 100%; margin: 0 auto; }
    </style>
  </head>
  <body class="flex flex-col items-center min-h-screen relative max-w-screen p-0 m-0">
    <main class="container min-h-screen px-2 flex flex-col gap-10 overflow-hidden mx-auto relative md:pr-[17%]">
      <a href="/" class="absolute top-0 left-0 cursor-pointer z-20" aria-label="Home">
        <span class="flex h-20 w-20 items-center justify-center font-fugaz text-3xl">FK</span>
      </a>
      <slot />
      <DeskMenu />
      <Hamburger client:idle />
    </main>
    {footer && <Footer />}
  </body>
</html>

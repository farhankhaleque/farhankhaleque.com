---
// Detail page for a role or a lookbook project (adapted from Big City's post layout).
import Layout from "./Layout.astro";
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  subtitle: string;
  meta: string[];
  color: string;
  image?: string;
  back: { href: string; text: string };
  description: string;
  tags?: string[];
  next?: { href: string; text: string };
}
const { title, subtitle, meta, color, image, back, description, tags = [], next } = Astro.props;
---

<Layout title={title} description={description}>
  <article class="self-center w-full max-w-[1000px] px-4 md:px-6 pt-24 pb-32">
    <a href={back.href} class="inline-flex items-center gap-2 text-lg mb-10 animated-link">
      <Icon name="arrow" class="w-6 h-6 -rotate-90" /> {back.text}
    </a>
    {image ? (
      <img src={image} alt={title} class="w-full max-h-[70vh] object-contain mb-10" loading="eager" />
    ) : (
      <div class="w-full min-h-[40vh] flex items-end p-6 md:p-10 text-white mb-10 border border-white/10" style={`background-color:${color}`}>
        <h1 class="font-display text-5xl md:text-8xl leading-none">{title}</h1>
      </div>
    )}
    <div class="flex flex-col md:flex-row md:justify-between gap-4 border-b border-white/25 pb-6 mb-8">
      <div>
        {image && <h1 class="font-display text-5xl md:text-7xl leading-none mb-3">{title}</h1>}
        <p class="text-2xl md:text-3xl font-semibold">{subtitle}</p>
      </div>
      <div class="md:text-right text-lg">
        {meta.map((m) => <p>{m}</p>)}
      </div>
    </div>
    <div class="entry text-lg md:text-xl max-w-3xl">
      <slot />
    </div>
    {tags.length > 0 && (
      <ul class="flex flex-wrap gap-2 mt-10">
        {tags.map((t) => <li class="border border-white/40 px-3 py-1 rounded-full text-sm">{t}</li>)}
      </ul>
    )}
    {next && (
      <a href={next.href} class="mt-20 flex justify-end items-center gap-3 text-2xl md:text-3xl font-display group">
        {next.text}
        <Icon name="arrow" class="w-8 h-8 rotate-90 group-hover:translate-x-2 transition" />
      </a>
    )}
  </article>
</Layout>
